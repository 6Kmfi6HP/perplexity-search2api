# ===========================================================================
# Perplexity Search2API Environment Configuration
# ===========================================================================

# [Server Configuration]
# Server listening host and port
HOST=0.0.0.0
PORT=8000

# [Security & Authentication]
# Optional API Key to protect the proxy service endpoints (/v1/chat/completions, /v1/models, /search)
# If set, clients must pass `Authorization: Bearer <API_KEY>` or `api-key: <API_KEY>` header.
# Leave empty to disable authentication (allow all local/internal requests).
API_KEY=

# [Perplexity Credentials Configuration]
# Optional custom path for the session credentials JSON file (default: ~/.perplexity_session.json)
# PERPLEXITY_SESSION_PATH=./.perplexity_session.json

# Optional direct injection of NextAuth session token (useful in Docker / CI environments)
# PERPLEXITY_SESSION_TOKEN=

# Optional user metadata when injecting token via environment variables
# PERPLEXITY_USER_NAME=ProUser
# PERPLEXITY_USER_EMAIL=user@example.com
